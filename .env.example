# Compose and native Spring Boot read .env. Use unquoted KEY=value entries.
DB_URL=jdbc:postgresql://localhost:5432/harbor
DB_USER=postgres
DB_PASSWORD=postgres
ADMIN_EMAIL=admin@hospital.local
ADMIN_PASSWORD=change-this-admin-password
SEED_DEMO=true
WEB_PORT=3000
HOSPITAL_TIMEZONE=Asia/Dhaka
PUBLIC_URL=http://localhost:5173
DOCKER_PUBLIC_URL=http://localhost:3000
# Supply the hospital's real contact details; leave blank until available.
HOSPITAL_ADDRESS=
RECEPTION_PHONE=
DIRECTIONS_URL=
VISIT_INSTRUCTIONS=Bring your appointment confirmation and relevant medical records. Check in at reception before going to your consultation room.
# Enable mail with an SMTP provider or: docker compose --profile mail up --build
MAIL_ENABLED=false
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_TLS=false
MAIL_FROM=appointments@hospital.local
